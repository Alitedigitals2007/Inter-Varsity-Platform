# ── Database (Neon Postgres) ─────────────────────────────
# REQUIRED. Replace with your real Neon connection string
# (Neon console → Connection string → Postgres). Without this the app
# cannot run db:push, db:seed, or serve any match data.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ── Session auth ─────────────────────────────────────────
# Random secret used to sign/identify sessions (change in production)
SESSION_SECRET="change-me-to-a-long-random-string"

# Session lifetimes (hours)
SESSION_TTL_HOURS="24"

# ── Realtime (Ably) ──────────────────────────────────────
# OPTIONAL. When set, browsers receive live match events over Ably push.
# When empty/absent, every client polls the snapshot endpoint every 2.5 s
# (fully functional — used by the offline installer and LAN mode).
# Get a key: https://ably.com → your app → API Keys → copy the key
# (format: appId.keyId:secret). Set it in Vercel → Settings → Environment
# Variables as ABLY_API_KEY (server-side only — never expose to the browser).
ABLY_API_KEY=""

# ── Production admin (online only) ───────────────────────
# Used by `npm run db:seed` on the production database so the seeded admin
# account is NOT the public default. Leave empty for local demo seeding.
ADMIN_PASSWORD=""
